---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="reveal mb-10 max-w-2xl">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[.25em] text-lime-300">{eyebrow}</p>
  <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 leading-7 text-zinc-400">{description}</p>}
</div>