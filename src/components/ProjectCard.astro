---
interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
  href?: string;
}
const { number, title, description, tags, href = "#" } = Astro.props;
---

<article class="project-card reveal group rounded-3xl border border-white/10 bg-white/[.025] p-6">
  <div class="mb-12 flex items-start justify-between">
    <span class="text-sm text-zinc-500">{number}</span>
    <a href={href} class="grid h-10 w-10 place-items-center rounded-full border border-white/10 text-zinc-400 transition group-hover:border-lime-300/40 group-hover:text-lime-300" aria-label={`Open ${title}`}>
      ↗
    </a>
  </div>

  <h3 class="text-2xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-3 min-h-20 leading-7 text-zinc-400">{description}</p>

  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-400">{tag}</span>
    ))}
  </div>
</article>