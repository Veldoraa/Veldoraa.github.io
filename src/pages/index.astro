---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";

const skills = ["HTML", "CSS", "JavaScript", "Astro", "Tailwind CSS", "UI Design", "Git", "Responsive Design"];

const projects = [
  {
    number: "01",
    title: "Project One",
    description: "Ganti bagian ini dengan proyek terbaikmu. Ceritakan masalah yang diselesaikan, proses singkat, dan hasil akhirnya.",
    tags: ["Astro", "Tailwind", "JavaScript"]
  },
  {
    number: "02",
    title: "Project Two",
    description: "Project kedua bisa berupa website, aplikasi, desain, karya akademik, atau project personal yang ingin kamu tampilkan.",
    tags: ["Web", "UI/UX", "Responsive"]
  },
  {
    number: "03",
    title: "Project Three",
    description: "Gunakan kartu ini untuk menunjukkan kemampuan lain dan berikan tautan ke demo atau repository jika tersedia.",
    tags: ["JavaScript", "API", "Git"]
  }
];
---

<Layout
  title="Yuansyah Hardian — Personal Portfolio"
  description="Personal portfolio website built with Astro and Tailwind CSS."
>
  <Navbar />

  <main>
    <!-- HERO -->
    <section id="home" class="relative flex min-h-screen items-center px-5 pb-20 pt-32">
      <div class="mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.25fr_.75fr]">
        <div class="reveal">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[.03] px-4 py-2 text-xs text-zinc-400">
            <span class="h-2 w-2 rounded-full bg-lime-300 shadow-[0_0_14px_rgba(163,230,53,.8)]"></span>
            Available for selected projects
          </div>

          <p class="mb-4 text-sm uppercase tracking-[.28em] text-zinc-500">Hello, I’m</p>

          <h1 class="max-w-4xl text-6xl font-semibold leading-[.95] tracking-[-.055em] sm:text-7xl lg:text-8xl">
            Yuansyah Hardian Putra
            <span class="text-lime-300"> Pratama.</span>
          </h1>

          <p class="mt-8 max-w-xl text-lg leading-8 text-zinc-400">
            A creative developer who enjoys turning ideas into clean, useful, and memorable digital experiences.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#projects" class="rounded-full bg-lime-300 px-6 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-lime-200">
              Explore my work 🧐
            </a>
            <a href="#contact" class="rounded-full border border-white/10 px-6 py-3 text-sm font-semibold text-zinc-200 transition hover:bg-white/5">
              Let’s Connect 👋👋
            </a>
          </div>
        </div>

        <div class="reveal relative mx-auto w-full max-w-sm lg:ml-auto" style="transition-delay:120ms">
          <div class="aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-lime-300/20 via-zinc-900 to-blue-500/10 p-2">
            <div class="flex h-full flex-col justify-between rounded-[1.55rem] border border-white/10 bg-zinc-950/70 p-6">
              <div class="flex justify-between text-xs text-zinc-500">
                <span>PROFILE / 001</span>
                <span>2026</span>
              </div>

              <div>
                <div class="mb-6 grid h-24 w-24 place-items-center rounded-3xl border border-white/10 bg-white/5 text-4xl">
                  ✦
                </div>
                <p class="text-sm text-zinc-500">Based in</p>
                <p class="mt-1 text-lg text-zinc-200">Indonesia</p>
              </div>

              <div class="border-t border-white/10 pt-5 text-sm leading-6 text-zinc-500">
                Replace this visual block with your own portrait or creative artwork later.
              </div>
            </div>
          </div>
          <div class="absolute -bottom-5 -left-5 rounded-2xl border border-white/10 bg-zinc-950/90 px-4 py-3 text-xs text-zinc-400 shadow-2xl backdrop-blur">
            <span class="text-lime-300">●</span> Building something meaningful
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="px-5 py-28">
      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="01 — About"
          title="A little bit about me."
          description="Bagian ini nanti kita isi dengan cerita personalmu: siapa kamu, apa yang kamu kerjakan, dan apa yang membuatmu tertarik pada bidangmu."
        />

        <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
          <div class="reveal rounded-3xl border border-white/10 bg-white/[.025] p-7">
            <p class="leading-8 text-zinc-300">
              I'm a Bachelor of Informatics graduate from Tanjungpura University with hands-on experience in Android app development, React web development, backend such as Firebase, Node.Js, and data analysis. I've also got a solid grasp of machine learning, which helps me dive deeper into working with data.
              I'm always excited to sharpen my technical skills and stay open to opportunities where I can not only refine what I already know and pick up new tools and technologies. Lately, I've been exploring React for web and data projects, expanding my web development skill set, and diving into data analytics and data science.
              I'm passionate about projects that foster innovation, teamwork, and creative problem-solving. I'm on the lookout for a role where I can leverage my skills in app development, React, and data analytics, while continuously growing and adapting to the fast-moving tech world.
            </p>
          </div>

          <div class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10">
            <div class="bg-zinc-950 p-7">
              <p class="text-xs uppercase tracking-widest text-zinc-500">Focus</p>
              <p class="mt-3 text-lg font-medium">Web & Digital</p>
            </div>
            <div class="bg-zinc-950 p-7">
              <p class="text-xs uppercase tracking-widest text-zinc-500">Location</p>
              <p class="mt-3 text-lg font-medium">Indonesia</p>
            </div>
            <div class="bg-zinc-950 p-7">
              <p class="text-xs uppercase tracking-widest text-zinc-500">Mindset</p>
              <p class="mt-3 text-lg font-medium">Always learning</p>
            </div>
            <div class="bg-zinc-950 p-7">
              <p class="text-xs uppercase tracking-widest text-zinc-500">Status</p>
              <p class="mt-3 text-lg font-medium">Open to ideas</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="border-y border-white/5 px-5 py-28">
      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="02 — Skills"
          title="Tools I use to build things."
          description="Skill di bawah masih placeholder. Nanti tinggal kita sesuaikan dengan kemampuanmu."
        />

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {skills.map((skill, index) => (
            <div class="reveal rounded-2xl border border-white/10 bg-white/[.025] p-5 transition hover:border-lime-300/30 hover:bg-white/[.045]" style={`transition-delay:${index * 40}ms`}>
              <div class="mb-8 text-xs text-zinc-600">0{index + 1}</div>
              <p class="font-medium">{skill}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="px-5 py-28">
      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="03 — Selected work"
          title="Projects I’m proud of."
          description="Tampilkan 3–6 karya terbaik. Fokus pada kualitas cerita dan hasil, bukan jumlah."
        />

        <div class="grid gap-5 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="border-y border-white/5 px-5 py-28">
      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="04 — Experience"
          title="Where I’ve been learning and growing."
        />

        <div class="max-w-4xl">
          {[
            ["2026 — Present", "Your Current Role", "Company / Organization", "Tuliskan tanggung jawab dan pencapaian utama di sini."],
            ["2024 — 2026", "Previous Experience", "Company / Organization", "Tuliskan pengalaman sebelumnya, organisasi, freelance, atau kegiatan relevan."]
          ].map((item, index) => (
            <div class="reveal grid gap-3 border-t border-white/10 py-7 sm:grid-cols-[160px_1fr]" style={`transition-delay:${index * 80}ms`}>
              <p class="text-sm text-lime-300">{item[0]}</p>
              <div>
                <h3 class="text-xl font-medium">{item[1]}</h3>
                <p class="mt-1 text-sm text-zinc-500">{item[2]}</p>
                <p class="mt-4 max-w-2xl leading-7 text-zinc-400">{item[3]}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="px-5 py-32">
      <div class="mx-auto max-w-6xl">
        <div class="reveal overflow-hidden rounded-[2rem] border border-lime-300/20 bg-lime-300 p-8 text-zinc-950 sm:p-12 lg:p-16">
          <p class="text-xs font-bold uppercase tracking-[.25em]">05 — Contact</p>
          <div class="mt-5 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
              <h2 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-.04em] sm:text-6xl">
                Have an idea?<br />Let’s make it real.
              </h2>
              <p class="mt-6 max-w-xl leading-7 text-zinc-800/70">
                Ganti email dan social media di bagian ini dengan milikmu.
              </p>
            </div>
            <a href="mailto:yuansyahhardianputrapratama@egmail.com" class="inline-flex rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition hover:scale-[1.02]">
              yuansyahhardianputrapratama@gmail.com ↗
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/5 px-5 py-8">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Yuansyah Hardian. All rights reserved.</p>
      <div class="flex gap-5">
        <a class="hover:text-white" href="#">GitHub</a>
        <a class="hover:text-white" href="#">LinkedIn</a>
        <a class="hover:text-white" href="#">Instagram</a>
      </div>
    </div>
  </footer>

  <script>
    const menuButton = document.querySelector("#menu-button");
    const mobileMenu = document.querySelector("#mobile-menu");

    menuButton?.addEventListener("click", () => {
      const isOpen = !mobileMenu?.classList.contains("hidden");
      mobileMenu?.classList.toggle("hidden");
      menuButton.setAttribute("aria-expanded", String(!isOpen));
    });

    document.querySelectorAll("#mobile-menu a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("hidden");
        menuButton?.setAttribute("aria-expanded", "false");
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  </script>
</Layout>